# =============================================================================
# SERVER-SIDE (read by server.ts via dotenv — never shipped to the browser)
# =============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: The port the Express + Vite server listens on. Defaults to 3001 if unset.
PORT="3001"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


# =============================================================================
# CLIENT-SIDE (read by the React bundle)
#
# Vite only exposes variables prefixed with VITE_ to browser code, so every
# flag below MUST keep that prefix. They are read once in src/config.ts, which
# applies the defaults shown here when a variable is missing or malformed.
# Changing any of these requires a dev-server restart — Vite reads .env at
# startup and inlines the values at build time.
# =============================================================================

# --- Sign-in & registration ---------------------------------------------------

# VITE_DEMO_OTP: the fixed one-time code every mobile number accepts in the
# OTP sign-in and self-registration flows. There is no SMS gateway and no auth
# server in this build, so this is a TEST FIXTURE that lets a tester get through
# the flow — it is not a security control. Wiring a real gateway means moving
# verification server-side, at which point this setting is deleted rather than
# changed to something secret.
VITE_DEMO_OTP="123456"

# VITE_OTP_LOGIN_ENABLED: offer "Mobile & OTP" alongside password sign-in.
# Set to false to leave only email + password.
VITE_OTP_LOGIN_ENABLED="true"

# VITE_PATIENT_SELF_REGISTRATION: show the "New patient? Register" option on the
# sign-in screen, which takes a name and mobile number, confirms by OTP, and
# creates the patient record. Set to false to make registration desk-only.
VITE_PATIENT_SELF_REGISTRATION="true"

# --- Patient portal ----------------------------------------------------------

# VITE_SINGLE_PATIENT_PROFILE: when true a signed-in patient is restricted to
# one profile — their own. The "Switch Family Profile" / "Select Profile"
# pickers are hidden and the "Register Patient", "Add Patient" and "Register New
# Profile" actions are removed, so a patient cannot create additional profiles.
# Set to false to restore multi-profile family mode, where one login can hold
# and switch between several patient records.
# Front desk and admin consoles are unaffected either way — registering patients
# stays a clinic desk function.
VITE_SINGLE_PATIENT_PROFILE="true"

# VITE_BOOKING_USE_LOGGED_IN_PATIENT: when true, a signed-in patient books for
# themselves — the "Who is this appointment for?" block on step 2 (saved-profile
# picker, "Someone new", and the name / age / mobile fields) is hidden and the
# booking is filled from their own profile. Set to false to show the picker
# again so one login can book on behalf of someone else.
# Front desk and admin always keep the picker: booking for walk-ins is the whole
# point of their console.
VITE_BOOKING_USE_LOGGED_IN_PATIENT="true"

# --- Doctor console ----------------------------------------------------------

# VITE_DOCTOR_HIDE_RECORDS_MENU: when true the "Records" rail group (Clinical
# Patients + Document Vault) is withdrawn from the doctor persona. A doctor
# still sees each patient's history, documents and past visits inside their
# appointment queue. Front desk and admin keep the Records group regardless.
# Set to false to give doctors the standalone Records pages back.
VITE_DOCTOR_HIDE_RECORDS_MENU="true"

# VITE_DOCTOR_LAND_ON_DASHBOARD: open a doctor's session on their KPI dashboard
# instead of their profile page.
VITE_DOCTOR_LAND_ON_DASHBOARD="true"

# --- Doctor directory (Book an appointment → Step 1) -------------------------

# VITE_DOCTOR_LIST_REQUIRE_SEARCH: when true the doctor list stays hidden until
# the patient actually searches — the page opens on a search prompt instead of
# dumping every doctor on file. Set to false to restore the old behaviour of
# listing all doctors by default.
VITE_DOCTOR_LIST_REQUIRE_SEARCH="true"

# VITE_DOCTOR_SEARCH_MIN_CHARS: how many characters must be typed before results
# are revealed. Prevents a single "a" from matching the whole directory.
VITE_DOCTOR_SEARCH_MIN_CHARS="2"

# VITE_DOCTOR_REVEAL_ON_FILTER: when true, choosing a department / city / state /
# consultation-mode filter also counts as "searching" and reveals the list.
# Set to false to require a typed query, no matter which filters are set.
VITE_DOCTOR_REVEAL_ON_FILTER="true"

# VITE_DOCTOR_MAX_RESULTS: safety cap on how many matching doctors are rendered
# at once (0 = no cap). Keeps the first page fast in large directories.
VITE_DOCTOR_MAX_RESULTS="24"

# --- Clinic location & maps --------------------------------------------------

# VITE_DOCTOR_MAP_ENABLED: show the pin-pointed map thumbnail on each doctor
# card and the "open in map view" dialog. Set to false to hide all map UI
# (useful for offline/air-gapped deployments where tiles cannot be fetched).
VITE_DOCTOR_MAP_ENABLED="true"

# VITE_DOCTOR_MAP_ZOOM: zoom level of the card thumbnail (3 = country,
# 16 = street, 19 = building). The expanded map view uses this + 1.
VITE_DOCTOR_MAP_ZOOM="16"

# VITE_DOCTOR_MAP_LINK_PROVIDER: which map service the "Open in Maps" and
# "Directions" buttons hand off to. One of: google | osm
VITE_DOCTOR_MAP_LINK_PROVIDER="google"

# VITE_MAP_TILE_URL: slippy-map tile template used to draw the static
# thumbnail. Must contain {z}/{x}/{y}. Swap in your own tile host (Mapbox,
# MapTiler, Thunderforest, a self-hosted server…) if you exceed the
# OpenStreetMap community tile usage policy.
VITE_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"

# VITE_MAP_TILE_ATTRIBUTION: attribution line printed under the map. Required
# by most tile providers, including OpenStreetMap.
VITE_MAP_TILE_ATTRIBUTION="© OpenStreetMap contributors"
